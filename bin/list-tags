#!/usr/bin/env node
// Prints every tag used by posts, one per line, sorted.
import { readdirSync, readFileSync } from "node:fs";
import { join } from "node:path";
import { parse } from "yaml";

const postsDir = new URL("../content/posts", import.meta.url).pathname;

const tags = new Set();

for (const name of readdirSync(postsDir)) {
  if (!/\.mdx?$/.test(name)) continue;

  const raw = readFileSync(join(postsDir, name), "utf8");
  const match = /^---\n([\s\S]*?)\n---/.exec(raw);
  if (!match) continue;

  for (const tag of parse(match[1])?.tags ?? []) tags.add(tag);
}

console.log([...tags].sort().join("\n"));
