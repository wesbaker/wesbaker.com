---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageHeader from "../../../components/PageHeader.astro";
import PostList from "../../../components/PostList.astro";
import Pagination from "../../../components/Pagination.astro";
import { getPosts } from "../../../utils";
import { POSTS_PER_PAGE } from "../../../consts";

export async function getStaticPaths() {
  const posts = await getPosts();
  const pageCount = Math.max(1, Math.ceil(posts.length / POSTS_PER_PAGE));

  // `/posts/page/1/` redirects to `/posts/` so both spellings resolve.
  return Array.from({ length: pageCount }, (_, index) => {
    const page = index + 1;
    return {
      params: { page: String(page) },
      props: {
        page,
        pageCount,
        posts: posts.slice((page - 1) * POSTS_PER_PAGE, page * POSTS_PER_PAGE),
      },
    };
  });
}

const { page, pageCount, posts } = Astro.props;
---

{
  page === 1 ? (
    <html lang="en">
      <head>
        <meta charset="utf-8" />
        <meta http-equiv="refresh" content="0; url=/posts/" />
        <link rel="canonical" href="/posts/" />
        <title>Redirecting to /posts/</title>
      </head>
      <body>
        <p>
          <a href="/posts/">Click here</a> to be redirected.
        </p>
      </body>
    </html>
  ) : (
    <BaseLayout title="Posts">
      <PageHeader title="Posts" />

      <main class="post-list">
        <PostList posts={posts} />
      </main>

      <Pagination current={page} pageCount={pageCount} />
    </BaseLayout>
  )
}
