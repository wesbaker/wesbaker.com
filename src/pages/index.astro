---
import { getEntry, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import PostList from "../components/PostList.astro";
import { getPosts } from "../utils";
import { HOMEPAGE_POSTS } from "../consts";

const home = await getEntry("pages", "home");
if (!home) throw new Error("Missing content/pages/home.md");

const { Content } = await render(home);
const posts = (await getPosts()).slice(0, HOMEPAGE_POSTS);
---

<BaseLayout description={home.data.description}>
  <main>
    <article>
      <section class="body">
        <PageHeader title={home.data.title} subtitle={home.data.subtitle} />
        <Content />
      </section>
    </article>
  </main>

  <h2><a href="/posts/">Recent Posts</a></h2>

  <main class="post-list">
    <PostList posts={posts} />
  </main>
</BaseLayout>
