---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Rendered width; images are emitted as WebP at this size. */
  width?: number;
}

const { src, alt, width = 800 } = Astro.props;
const hasCaption = Astro.slots.has("default");
---

<figure>
  <Image src={src} alt={alt} width={width} format="webp" quality={85} />
  {
    hasCaption && (
      <figcaption>
        <slot />
      </figcaption>
    )
  }
</figure>
