---
import { MENU, SOCIALS, SITE } from "../consts";
---

<nav>
  <div class="left-nav">
    <a href="/">{SITE.title}</a>

    <div class="socials">
      {
        SOCIALS.map((social) => (
          <a rel="me" href={social.url} class="social">
            <img alt={social.name} src={`/icons/social/${social.icon}.svg`} />
          </a>
        ))
      }
    </div>
  </div>

  <div class="right-nav">
    {MENU.map((item) => <a href={item.url}>{item.name}</a>)}
  </div>
</nav>
